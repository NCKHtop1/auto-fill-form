{
  "version": 2,
  "functions": {
    "api/bridge.js": {
      "maxDuration": 30
    },
    "api/auth/*.js": {
      "maxDuration": 15
    },
    "api/qa-submit.js": {
      "maxDuration": 60
    },
    "api/qa-verify.js": {
      "maxDuration": 30
    },
    "api/qa-status.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
