{
  "version": 2,
  "functions": {
    "api/bridge.js": {"maxDuration": 30},
    "api/auth/*.js": {"maxDuration": 15},
    "api/qa-submit.js": {"maxDuration": 60},
    "api/qa-verify.js": {"maxDuration": 30},
    "api/qa-status.js": {"maxDuration": 30},
    "api/billing.js": {"maxDuration": 60},
    "api/admin-topups.js": {"maxDuration": 60},
    "api/billing-notifications.js": {"maxDuration": 60}
  },
  "crons": [
    {
      "path": "/api/billing-notifications",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
