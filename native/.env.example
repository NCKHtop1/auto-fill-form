# Google OAuth web client (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_SESSION_SECRET=
PUBLIC_SITE_URL=https://auto-fill-form-liard.vercel.app
# Legacy QA flags. The live Step 6 route checks Google sign-in and the public
# respondent form; these legacy allowlists are not payment administrator roles.
PANDASTUDY_ADMIN_EMAILS=
PANDASTUDY_TEST_FORM_IDS=
ENABLE_QA_SUBMISSIONS=false

# Manual bank top-ups. Keep disabled until production UAT is complete.
BILLING_ENABLED=false
BILLING_TOPUPS_PAUSED=false
DATABASE_URL=
# Comma-separated verified Google identities permitted to approve payments.
BILLING_ADMIN_EMAILS=
# Configure recipients separately; this does not grant administrator access.
BILLING_NOTIFICATION_EMAILS=
# Merchant details belong in environment configuration, not in the repository.
BILLING_BANK_ID=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_ACCOUNT_NAME=
# Approved QR asset served from the same origin as the application.
# No real QR asset is included in this repository.
BILLING_QR_IMAGE_URL=
RESEND_API_KEY=
# Use a sender on your own verified domain, never a placeholder in production.
BILLING_EMAIL_FROM=
BILLING_PUBLIC_SITE_URL=https://auto-fill-form-liard.vercel.app
# Random secret of at least 32 characters; configure securely in Vercel.
BILLING_CRON_SECRET=
# GitHub scheduled worker uses the matching repository secret
# PANDASTUDY_BILLING_CRON_SECRET and requires variable PANDASTUDY_BILLING_LIVE=true.
